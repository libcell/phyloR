id_seq <- id_seq[-1]
tmp_list <- lapply(1:length(id_seq), function(i) {
id <- id_seq[i]
tmp <- strsplit(id, "\\(")[[1]]
if (length(tmp) > 2) {
new_tmp <- NULL
new_tmp[1] <- tmp[1]
new_tmp[2] <- paste(tmp[-1], collapse = "(")
tmp <- new_tmp
}
tmp <- gsub(")$", "", tmp)
if (length(tmp) == 1) tmp <- c(tmp, NA)
tmp <- c(tmp, species)
return(tmp)
})
do.call(rbind, tmp_list)
})
